{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lighthouse.bible/schemas/manifest-v1.json",
  "title": "Lighthouse Bible Manifest",
  "description": "Schema for a Lighthouse Bible Database Collection manifest. The manifest enumerates every bible file available at a hosting endpoint and provides translation, license, and integrity metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "generated_at",
    "stats",
    "sources",
    "bibles"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stats": {
      "type": "object",
      "required": [
        "bibles",
        "languages",
        "total_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "bibles": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "bibles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bible"
      }
    }
  },
  "$defs": {
    "bible": {
      "type": "object",
      "required": [
        "id",
        "language",
        "translation",
        "license",
        "file",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "type": "string"
        },
        "translation": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "abbreviation": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "year_published": {
              "type": "integer"
            },
            "year_revision": {
              "type": "integer"
            },
            "publisher": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "wikipedia_url": {
              "type": "string",
              "format": "uri"
            },
            "script": {
              "type": "string",
              "enum": [
                "Simplified",
                "Traditional"
              ]
            }
          }
        },
        "license": {
          "type": "object",
          "required": [
            "name",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "public_domain",
                "permissive",
                "copyrighted",
                "unknown"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "file": {
          "type": "object",
          "required": [
            "path",
            "format",
            "size_bytes",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "original_filename": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "sqlite3"
              ]
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verse_table": {
              "type": "string"
            },
            "verse_count": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sample_verse": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
